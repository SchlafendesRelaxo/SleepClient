{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "icon": "icon.png",
    "description": "SleepClient - Premium Custom Minecraft Client",
    "authors": [
        "SleepCodes"
    ],
    "environment": "client",
    "entrypoints": {
        "preLaunch": [
            "org.polyfrost.polyplus.PolyPlusPreLaunch"
        ],
        "client": [
            "org.polyfrost.polyplus.PolyPlusEntrypoint"
        ],
        "voicechat": [
            "org.polyfrost.polyplus.client.network.p2p.P2PVoicechatPlugin"
        ],
        "debugify": [
            "org.polyfrost.polyplus.compat.DebugifyBannableFixes"
        ],
        "mixinsquared": [
            "org.polyfrost.polyplus.compat.RrlsMixinCanceller"
        ]
    },
    "languageAdapters": {
        "polyplus-early": "org.polyfrost.polyplus.compat.EarlyConfigAdapter"
    },
    "mixins": [
        "mixins.sleepclient.json"
    ],
    "depends": {
        "minecraft": "${minor_mc_version}",
        "fabric-api": "*",
        "fabricloader": ">=0.16.0",
        "java": ">=21",
        "fabric-language-kotlin": ">=1.14.1",
        "oneconfigv1": ">=${oneconfig_version}",
        "polycompose": ">=1.0.0"
    },
    "breaks": {
        "auto-reauth": "*",
        "wwaypoints": "<0.8.0"
    },
    "conflicts": {
        "rrls": "*"
    },
    "contact": {
        "homepage": "https://github.com/SchlafendesRelaxo/SleepClient",
        "sources": "https://github.com/SchlafendesRelaxo/SleepClient",
        "issues": "https://github.com/SchlafendesRelaxo/SleepClient/issues"
    },
    "provides": [
        "polyplus"
    ],
    "custom": {
        "sleepclient": {
            "loader": "${mod_loader}"
        }
    }
}